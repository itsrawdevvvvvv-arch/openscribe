<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/pill_ghost"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:text="@string/settings_title"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="SPEECH ENGINE"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Live dictation uses your phone's built-in recogniser — nothing is uploaded."
                android:textColor="@color/ink2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.04"
                android:text="Live language"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/lang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field"
                android:fontFamily="monospace"
                android:hint="en-IN"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="BCP-47 tag, e.g. en-IN, hi-IN, en-US"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.04"
                android:text="Prefer on-device recognition"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/offline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="FILE TRANSCRIPTION API"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Any OpenAI-compatible /audio/transcriptions endpoint. Your key is stored on-device only."
                android:textColor="@color/ink2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Base URL"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field"
                android:fontFamily="monospace"
                android:hint="https://api.openai.com/v1"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="API key"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field"
                android:fontFamily="monospace"
                android:hint="sk-…"
                android:inputType="textPassword"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Model"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field"
                android:fontFamily="monospace"
                android:hint="whisper-1"
                android:inputType="text"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Save"
            android:textColor="@color/card"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
